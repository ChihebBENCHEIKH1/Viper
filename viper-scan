#!/usr/bin/env bash
#
# viper-scan — Autonomous Android penetration testing via Claude CLI
#
# Usage:
#   ./viper-scan <apk-path> [--source <source-path>] [--phase <phase>] [--device usb]
#
# Phases:
#   static    Static analysis only (default) — decompile + code review
#   recon     Reconnaissance — attack surface mapping (requires device)
#   full      Full pipeline — static → recon → vuln → exploit → report
#
# Examples:
#   ./viper-scan ./myapp.apk
#   ./viper-scan ./myapp.apk --source ./android-project
#   ./viper-scan ./myapp.apk --phase full --device usb
#

set -euo pipefail

# === Colors ===
GREEN='\033[0;32m'
CYAN='\033[0;36m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
GRAY='\033[0;90m'
BOLD='\033[1m'
NC='\033[0m'

# === Defaults ===
APK_PATH=""
SOURCE_PATH=""
PHASE="static"
DEVICE_MODE="emulator"
MODEL="claude-opus-4-6"
MAX_TURNS=500
VIPER_DIR="$(cd "$(dirname "$0")" && pwd)"
PROMPTS_DIR="$VIPER_DIR/apps/worker/prompts"

RESUME_WORKSPACE=""

# === Parse Args ===
while [[ $# -gt 0 ]]; do
  case "$1" in
    --source|-s) SOURCE_PATH="$2"; shift 2 ;;
    --phase|-p) PHASE="$2"; shift 2 ;;
    --device|-d) DEVICE_MODE="$2"; shift 2 ;;
    --model|-m) MODEL="$2"; shift 2 ;;
    --max-turns) MAX_TURNS="$2"; shift 2 ;;
    --workspace|-w) RESUME_WORKSPACE="$2"; shift 2 ;;
    --help|-h)
      echo "Usage: ./viper-scan <apk-path> [--source <path>] [--phase static|recon|full] [--workspace <path>]"
      exit 0 ;;
    -*) echo "Unknown option: $1"; exit 1 ;;
    *) APK_PATH="$1"; shift ;;
  esac
done

if [[ -z "$APK_PATH" ]]; then
  echo -e "${RED}ERROR: APK path required${NC}"
  echo "Usage: ./viper-scan <apk-path> [--source <path>] [--phase static|recon|full]"
  exit 1
fi

APK_PATH="$(realpath "$APK_PATH")"
if [[ ! -f "$APK_PATH" ]]; then
  echo -e "${RED}ERROR: APK not found: $APK_PATH${NC}"
  exit 1
fi

# === Check Prerequisites ===
if ! command -v claude &>/dev/null; then
  echo -e "${RED}ERROR: claude CLI not found. Install Claude Code first.${NC}"
  exit 1
fi

if ! command -v jadx &>/dev/null; then
  echo -e "${YELLOW}WARNING: jadx not found. Will attempt decompilation inside Claude agent.${NC}"
fi

# === Splash ===
echo ""
echo -e "${GREEN}${BOLD}  ██╗   ██╗██╗██████╗ ███████╗██████╗ ${NC}"
echo -e "${GREEN}${BOLD}  ██║   ██║██║██╔══██╗██╔════╝██╔══██╗${NC}"
echo -e "${GREEN}${BOLD}  ██║   ██║██║██████╔╝█████╗  ██████╔╝${NC}"
echo -e "${GREEN}${BOLD}  ╚██╗ ██╔╝██║██╔═══╝ ██╔══╝  ██╔══██╗${NC}"
echo -e "${GREEN}${BOLD}   ╚████╔╝ ██║██║     ███████╗██║  ██║${NC}"
echo -e "${GREEN}${BOLD}    ╚═══╝  ╚═╝╚═╝     ╚══════╝╚═╝  ╚═╝${NC}"
echo ""
echo -e "${CYAN}  AI Android Penetration Testing Framework${NC}"
echo ""

# === Setup Workspace ===
if [[ -n "$RESUME_WORKSPACE" ]]; then
  WORKSPACE="$RESUME_WORKSPACE"
  echo -e "  ${YELLOW}Resuming workspace: $WORKSPACE${NC}"
else
  TIMESTAMP=$(date +%s)
  WORKSPACE="$VIPER_DIR/workspaces/scan-$TIMESTAMP"
fi
DECOMPILED="$WORKSPACE/decompiled"
DELIVERABLES="$WORKSPACE/deliverables"
mkdir -p "$DECOMPILED" "$DELIVERABLES"

echo -e "  ${BOLD}APK:${NC}        $APK_PATH"
[[ -n "$SOURCE_PATH" ]] && echo -e "  ${BOLD}Source:${NC}     $SOURCE_PATH"
echo -e "  ${BOLD}Phase:${NC}      $PHASE"
echo -e "  ${BOLD}Device:${NC}     $DEVICE_MODE"
echo -e "  ${BOLD}Model:${NC}      $MODEL"
echo -e "  ${BOLD}Workspace:${NC}  $WORKSPACE"
echo ""

# === Phase 1: Decompile APK ===
JAVA_COUNT=$(find "$DECOMPILED" -name "*.java" 2>/dev/null | wc -l)
if [[ "$JAVA_COUNT" -gt 0 ]]; then
  echo -e "${GREEN}  [1/5] Already decompiled ($JAVA_COUNT Java files) — skipping${NC}"
  echo ""
else
  echo -e "${CYAN}  [1/5] Decompiling APK...${NC}"

  if command -v jadx &>/dev/null; then
    jadx -d "$DECOMPILED/jadx/" "$APK_PATH" --no-debug-info 2>&1 | tail -3 || true
    echo -e "${GREEN}  JADX complete (some errors are normal).${NC}"
  else
    echo -e "${YELLOW}  JADX not available — agent will decompile during analysis.${NC}"
  fi

  if command -v apktool &>/dev/null; then
    apktool d -f -o "$DECOMPILED/apktool/" "$APK_PATH" 2>&1 | tail -3 || true
    echo -e "${GREEN}  APKTool complete.${NC}"
  fi

  JAVA_COUNT=$(find "$DECOMPILED" -name "*.java" 2>/dev/null | wc -l)
  echo -e "  ${GRAY}Decompiled: $JAVA_COUNT Java files${NC}"
  echo ""
fi

# === Build Prompt from Templates ===
build_prompt() {
  local TEMPLATE="$1"
  local PROMPT_FILE="$PROMPTS_DIR/$TEMPLATE.txt"

  if [[ ! -f "$PROMPT_FILE" ]]; then
    echo "ERROR: Prompt template not found: $PROMPT_FILE" >&2
    return 1
  fi

  # Process @include directives using python (bash regex can't handle parentheses)
  local CONTENT
  CONTENT=$(python3 -c "
import re, sys, os

prompts_dir = sys.argv[1]
with open(sys.argv[2], 'r') as f:
    content = f.read()

def resolve_include(match):
    inc_path = match.group(1)
    full_path = os.path.join(prompts_dir, inc_path)
    if os.path.exists(full_path):
        with open(full_path, 'r') as f:
            return f.read()
    return ''

# Resolve includes (up to 3 levels deep)
for _ in range(3):
    content = re.sub(r'@include\(([^)]+)\)', resolve_include, content)

print(content)
" "$PROMPTS_DIR" "$PROMPT_FILE")

  # Detect package name from decompiled source
  local PKG_NAME="unknown"
  if [[ -f "$DECOMPILED/apktool/AndroidManifest.xml" ]]; then
    PKG_NAME=$(grep -oP 'package="\K[^"]+' "$DECOMPILED/apktool/AndroidManifest.xml" 2>/dev/null || echo "unknown")
  elif [[ -d "$DECOMPILED/jadx/sources" ]]; then
    # Infer from directory structure
    PKG_NAME=$(find "$DECOMPILED/jadx/sources" -name "BuildConfig.java" -path "*/sources/*" 2>/dev/null | head -1 | sed 's|.*/sources/||;s|/BuildConfig.java||;s|/|.|g' || echo "unknown")
  fi

  # Variable substitution
  CONTENT="${CONTENT//\{\{APK_PATH\}\}/$APK_PATH}"
  CONTENT="${CONTENT//\{\{DECOMPILED_PATH\}\}/$DECOMPILED}"
  CONTENT="${CONTENT//\{\{PACKAGE_NAME\}\}/$PKG_NAME}"
  CONTENT="${CONTENT//\{\{SOURCE_PATH\}\}/${SOURCE_PATH:-"(not available — black-box mode)"}}"
  CONTENT="${CONTENT//\{\{EMULATOR_HOST\}\}/localhost}"
  CONTENT="${CONTENT//\{\{EMULATOR_PORT\}\}/5555}"
  CONTENT="${CONTENT//\{\{API_LEVEL\}\}/34}"
  CONTENT="${CONTENT//\{\{DESCRIPTION\}\}/}"
  CONTENT="${CONTENT//\{\{RULES_AVOID\}\}/None specified}"
  CONTENT="${CONTENT//\{\{RULES_FOCUS\}\}/None specified}"
  CONTENT="${CONTENT//\{\{AUTH_CONTEXT\}\}/No authentication credentials provided.}"

  echo "$CONTENT"
}

# === Run Agent ===
run_agent() {
  local AGENT_NAME="$1"
  local TEMPLATE="$2"
  local AGENT_MODEL="${3:-$MODEL}"
  local AGENT_TURNS="${4:-$MAX_TURNS}"

  echo -e "${CYAN}  Running agent: ${BOLD}$AGENT_NAME${NC}"
  echo -e "  ${GRAY}Model: $AGENT_MODEL | Max turns: $AGENT_TURNS${NC}"

  local PROMPT
  PROMPT=$(build_prompt "$TEMPLATE")

  if [[ -z "$PROMPT" ]]; then
    echo -e "${RED}  Failed to build prompt for $AGENT_NAME${NC}"
    return 1
  fi

  local PROMPT_FILE
  PROMPT_FILE=$(mktemp /tmp/viper-prompt-XXXXXX.txt)
  echo "$PROMPT" > "$PROMPT_FILE"

  local LOG_FILE="$WORKSPACE/${AGENT_NAME}.log"
  local START_TIME=$SECONDS

  # Run Claude CLI autonomously — pipe prompt via stdin
  # Output goes to log AND terminal (tee) so you can see progress
  claude \
    --model "$AGENT_MODEL" \
    --max-turns "$AGENT_TURNS" \
    --verbose \
    --dangerously-skip-permissions \
    -p < "$PROMPT_FILE" 2>&1 | tee "$LOG_FILE"

  local EXIT_CODE=$?
  local DURATION=$(( SECONDS - START_TIME ))

  rm -f "$PROMPT_FILE"

  if [[ $EXIT_CODE -eq 0 ]]; then
    echo -e "  ${GREEN}✓ $AGENT_NAME completed in ${DURATION}s${NC}"
  else
    echo -e "  ${RED}✗ $AGENT_NAME failed (exit $EXIT_CODE) after ${DURATION}s — see $LOG_FILE${NC}"
  fi

  # Check deliverables
  for f in "$DELIVERABLES"/*"${AGENT_NAME//-/_}"*; do
    if [[ -f "$f" ]]; then
      local LINES
      LINES=$(wc -l < "$f")
      echo -e "  ${GREEN}  → $(basename "$f") ($LINES lines)${NC}"
    fi
  done 2>/dev/null
  echo ""
}

# === Run Agent in Background (for parallel execution) ===
run_agent_bg() {
  local AGENT_NAME="$1"
  local TEMPLATE="$2"
  local AGENT_MODEL="${3:-$MODEL}"
  local AGENT_TURNS="${4:-$MAX_TURNS}"

  local PROMPT
  PROMPT=$(build_prompt "$TEMPLATE")

  if [[ -z "$PROMPT" ]]; then
    echo -e "${RED}  Failed to build prompt for $AGENT_NAME${NC}"
    return 1
  fi

  local PROMPT_FILE
  PROMPT_FILE=$(mktemp /tmp/viper-prompt-XXXXXX.txt)
  echo "$PROMPT" > "$PROMPT_FILE"

  local LOG_FILE="$WORKSPACE/${AGENT_NAME}.log"

  echo -e "  ${CYAN}⚡ Spawning: ${BOLD}$AGENT_NAME${NC} ${GRAY}(background)${NC}"

  # Run in background — log to file, prompt via stdin
  (
    claude \
      --model "$AGENT_MODEL" \
      --max-turns "$AGENT_TURNS" \
      --verbose \
      --dangerously-skip-permissions \
      -p < "$PROMPT_FILE" > "$LOG_FILE" 2>&1
    rm -f "$PROMPT_FILE"
  ) &

  # Return the PID via a file (bash bg job tracking)
  echo $! > "$WORKSPACE/.pid-${AGENT_NAME}"
}

# === Wait for all background agents ===
wait_for_agents() {
  local AGENTS=("$@")
  local ALL_DONE=false

  echo ""
  echo -e "  ${CYAN}Waiting for ${#AGENTS[@]} parallel agents...${NC}"

  while [[ "$ALL_DONE" == "false" ]]; do
    ALL_DONE=true
    for AGENT_NAME in "${AGENTS[@]}"; do
      local PID_FILE="$WORKSPACE/.pid-${AGENT_NAME}"
      if [[ -f "$PID_FILE" ]]; then
        local PID
        PID=$(cat "$PID_FILE")
        if kill -0 "$PID" 2>/dev/null; then
          ALL_DONE=false
        else
          # Agent finished — report result
          wait "$PID" 2>/dev/null
          local EXIT_CODE=$?
          rm -f "$PID_FILE"
          if [[ $EXIT_CODE -eq 0 ]]; then
            echo -e "  ${GREEN}✓ $AGENT_NAME done${NC}"
          else
            echo -e "  ${RED}✗ $AGENT_NAME failed (exit $EXIT_CODE)${NC}"
          fi
          # Show deliverables
          for f in "$DELIVERABLES"/*"${AGENT_NAME//-/_}"*; do
            if [[ -f "$f" ]]; then
              echo -e "  ${GREEN}  → $(basename "$f") ($(wc -l < "$f") lines)${NC}"
            fi
          done 2>/dev/null
        fi
      fi
    done
    if [[ "$ALL_DONE" == "false" ]]; then
      local RUNNING=0
      for AGENT_NAME in "${AGENTS[@]}"; do
        [[ -f "$WORKSPACE/.pid-${AGENT_NAME}" ]] && RUNNING=$((RUNNING + 1))
      done
      echo -ne "\r  ${GRAY}  $RUNNING agents still running...${NC}   "
      sleep 5
    fi
  done
  echo ""
}

# === Execute Phases ===

case "$PHASE" in
  static)
    echo -e "${CYAN}  [2/5] Running static analysis agent...${NC}"
    echo ""
    run_agent "static-analysis" "static-analysis" "$MODEL" "$MAX_TURNS"
    ;;

  recon)
    echo -e "${CYAN}  [2/5] Running static analysis...${NC}"
    echo ""
    run_agent "static-analysis" "static-analysis" "$MODEL" "$MAX_TURNS"

    echo -e "${CYAN}  [3/5] Running reconnaissance...${NC}"
    echo ""
    run_agent "recon" "recon" "$MODEL" "$MAX_TURNS"
    ;;

  full)
    # === Phase 1: Static Analysis (skip if already done) ===
    if [[ -f "$DELIVERABLES/static_analysis_deliverable.md" ]]; then
      echo -e "${GREEN}  [2/5] Static analysis already done — skipping${NC}"
      echo ""
    else
      echo -e "${CYAN}  [2/5] Running static analysis...${NC}"
      echo ""
      run_agent "static-analysis" "static-analysis" "$MODEL" 200
    fi

    # === Phase 2: Reconnaissance (skip if already done) ===
    if [[ -f "$DELIVERABLES/recon_deliverable.md" ]]; then
      echo -e "${GREEN}  [3/5] Recon already done — skipping${NC}"
      echo ""
    else
      echo -e "${CYAN}  [3/5] Running reconnaissance...${NC}"
      echo ""
      run_agent "recon" "recon" "$MODEL" 150
    fi

    # === Phase 3: Vulnerability Analysis (5 agents IN PARALLEL) ===
    echo -e "${CYAN}  [4/5] Running vulnerability analysis (5 agents in parallel)...${NC}"
    echo ""
    VULN_AGENTS=()
    for VULN_TYPE in storage crypto auth network injection; do
      run_agent_bg "${VULN_TYPE}-vuln" "vuln-${VULN_TYPE}" "$MODEL" 150
      VULN_AGENTS+=("${VULN_TYPE}-vuln")
    done
    wait_for_agents "${VULN_AGENTS[@]}"

    # === Phase 4: Exploitation (parallel — only for vulns with findings) ===
    echo -e "${CYAN}  [5/5] Running exploitation + report...${NC}"
    echo ""
    EXPLOIT_AGENTS=()
    for VULN_TYPE in storage crypto auth network injection; do
      QUEUE="$DELIVERABLES/${VULN_TYPE}_exploitation_queue.json"
      if [[ -f "$QUEUE" ]]; then
        FINDINGS=$(python3 -c "import json; d=json.load(open('$QUEUE')); print(len(d.get('findings',[])))" 2>/dev/null || echo "0")
        if [[ "$FINDINGS" -gt 0 ]]; then
          echo -e "  ${YELLOW}$VULN_TYPE: $FINDINGS findings → spawning exploit agent${NC}"
          run_agent_bg "${VULN_TYPE}-exploit" "exploit-${VULN_TYPE}" "$MODEL" 150
          EXPLOIT_AGENTS+=("${VULN_TYPE}-exploit")
        else
          echo -e "  ${GRAY}$VULN_TYPE: no findings → skipping${NC}"
        fi
      else
        echo -e "  ${GRAY}$VULN_TYPE: no queue file → skipping${NC}"
      fi
    done

    if [[ ${#EXPLOIT_AGENTS[@]} -gt 0 ]]; then
      wait_for_agents "${EXPLOIT_AGENTS[@]}"
    else
      echo -e "  ${GRAY}No exploitation needed — no exploitable findings${NC}"
      echo ""
    fi

    # === Phase 5: Report (sequential — synthesizes everything) ===
    run_agent "report" "report-executive" "$MODEL" 100
    ;;

  *)
    echo -e "${RED}Unknown phase: $PHASE${NC}"
    echo "Valid phases: static, recon, full"
    exit 1
    ;;
esac

# === Summary ===
echo -e "${GREEN}${BOLD}  ═══════════════════════════════════════${NC}"
echo -e "${GREEN}${BOLD}  Scan Complete${NC}"
echo -e "${GREEN}${BOLD}  ═══════════════════════════════════════${NC}"
echo ""
echo -e "  ${BOLD}Workspace:${NC}    $WORKSPACE"
echo -e "  ${BOLD}Deliverables:${NC} $DELIVERABLES/"
echo ""

# List generated reports
if ls "$DELIVERABLES"/*.md &>/dev/null; then
  echo -e "  ${BOLD}Reports:${NC}"
  for f in "$DELIVERABLES"/*.md; do
    LINES=$(wc -l < "$f")
    echo -e "    $(basename "$f") ${GRAY}($LINES lines)${NC}"
  done
else
  echo -e "  ${YELLOW}No reports generated — check agent output above${NC}"
fi

echo ""
echo -e "  ${GRAY}Powered by Viper + Claude CLI${NC}"
echo ""
